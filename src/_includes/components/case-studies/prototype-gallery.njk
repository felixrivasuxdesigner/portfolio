<!-- Generic Prototype Gallery Component -->
{% set gui = translations[locale].case_study_ui.gallery %}
<div class="case-study-section prototype-gallery-section">
  <h2>{{ gui.title }}</h2>
  <p>{{ gui.intro }}</p>
  
  <div class="prototype-gallery" data-lightbox-group="prototype-gallery">
    {% for image in galleryImages %}
    {% set fullSrc = site.baseUrl + 'assets/img/gallery-img/' + projectKey + '/' + image.src %}
    <a href="{{ fullSrc }}" 
       class="gallery-item screen-item__trigger" 
       data-lightbox="gallery" 
       data-src="{{ fullSrc }}" 
       data-title="{{ image.title or image.alt | default(gui.screenAlt) }}" 
       data-caption="{{ image.caption or '' }}"
       aria-label="{{ image.alt | default(gui.screenAlt) }}: {{ gui.view }}">
      <img src="{{ fullSrc }}" alt="{{ image.alt | default(gui.screenAlt) }}" loading="lazy">
      <div class="gallery-overlay">
        <span>{{ gui.view }}</span>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
