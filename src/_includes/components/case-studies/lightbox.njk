<!-- Reusable Case Study Lightbox Component -->
{% set gui = translations[locale].case_study_ui.gallery %}
<div id="case-study-lightbox" class="lightbox-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{{ gui.title }}">
  <div class="lightbox-backdrop" data-lightbox-close></div>
  
  <div class="lightbox-container">
    <button type="button" class="lightbox-close" aria-label="{{ gui.close }}" data-lightbox-close>
      <span aria-hidden="true">&times;</span>
    </button>
    
    <button type="button" class="lightbox-nav prev" aria-label="{{ gui.prev }}" data-lightbox-prev>
      <span aria-hidden="true">&#10094;</span>
    </button>
    
    <div class="lightbox-stage">
      <div class="lightbox-image-wrapper">
        <img class="lightbox-content" id="lightbox-img" src="" alt="{{ gui.lightboxAlt }}">
        <div class="lightbox-loader" aria-hidden="true">
          <div class="lightbox-spinner"></div>
        </div>
      </div>
      
      <div class="lightbox-footer">
        <div class="lightbox-meta">
          <h3 class="lightbox-title" id="lightbox-title"></h3>
          <p class="lightbox-caption" id="lightbox-caption"></p>
        </div>
        <div class="lightbox-counter" aria-live="polite">
          <span class="lightbox-counter-current">1</span> / <span class="lightbox-counter-total">1</span>
        </div>
      </div>
    </div>
    
    <button type="button" class="lightbox-nav next" aria-label="{{ gui.next }}" data-lightbox-next>
      <span aria-hidden="true">&#10095;</span>
    </button>
  </div>
</div>
