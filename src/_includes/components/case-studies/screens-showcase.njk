<!-- Showcase de pantallas reales: recibe `showcase` (title, intro, items) y `showcaseVariant` (mobile | desktop) -->
<div class="case-study-section">
  <h2>{{ showcase.title }}</h2>
  {% if showcase.intro %}<p>{{ showcase.intro }}</p>{% endif %}
  <div class="case-study-screens case-study-screens--{{ showcaseVariant }}">
    {% for screen in showcase.items %}
      {% set screenSrc = site.baseUrl + 'assets/img/gallery-img/' + projectKey + '/' + screen.src %}
      <figure class="screen-item">
        {% if showcaseVariant == 'desktop' %}
          {# La miniatura es un recorte 16:10; el enlace abre la captura completa si existe #}
          {% set fullSrc = site.baseUrl + 'assets/img/gallery-img/' + projectKey + '/' + screen.full if screen.full else screenSrc %}
          <a href="{{ fullSrc }}" target="_blank" rel="noopener" aria-label="{{ screen.title }}: {{ showcase.openLabel }}">
            <img src="{{ screenSrc }}" alt="{{ screen.alt }}" loading="lazy" width="1600" height="1000">
          </a>
        {% else %}
          <img src="{{ screenSrc }}" alt="{{ screen.alt }}" loading="lazy" width="640" height="1423">
        {% endif %}
        <figcaption>
          <h3>{{ screen.title }}</h3>
          <p>{{ screen.caption }}</p>
        </figcaption>
      </figure>
    {% endfor %}
  </div>
</div>
