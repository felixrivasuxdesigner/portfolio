<!-- Showcase de pantallas reales: recibe `showcase` (title, intro, items) y `showcaseVariant` (mobile | desktop) -->
<div class="case-study-section">
  <h2>{{ showcase.title }}</h2>
  {% if showcase.intro %}<p>{{ showcase.intro }}</p>{% endif %}
  <div class="case-study-screens case-study-screens--{{ showcaseVariant }}">
    {% for screen in showcase.items %}
      {% set screenSrc = site.baseUrl + 'assets/img/gallery-img/' + projectKey + '/' + screen.src %}
      {% set fullSrc = site.baseUrl + 'assets/img/gallery-img/' + projectKey + '/' + screen.full if screen.full else screenSrc %}
      <figure class="screen-item">
        <a href="{{ fullSrc }}" 
           class="screen-item__trigger" 
           data-lightbox="gallery" 
           data-src="{{ fullSrc }}" 
           data-title="{{ screen.title }}" 
           data-caption="{{ screen.caption }}" 
           aria-label="{{ screen.title }}: {{ showcase.openLabel | default(translations[locale].case_study_ui.gallery.view) }}">
          {% if showcaseVariant == 'desktop' %}
            {# La miniatura es un recorte 16:10; en lightbox se muestra la captura completa #}
            <img src="{{ screenSrc }}" alt="{{ screen.alt }}" loading="lazy" width="1600" height="1000">
          {% else %}
            <img src="{{ screenSrc }}" alt="{{ screen.alt }}" loading="lazy" width="{{ screen.width or 640 }}" height="{{ screen.height or 1423 }}">
          {% endif %}
          <span class="screen-item__overlay" aria-hidden="true">
            <span class="screen-item__badge"><i class="fas fa-search-plus"></i> {{ translations[locale].case_study_ui.gallery.view | default('Ampliar') }}</span>
          </span>
        </a>
        <figcaption>
          <h3>{{ screen.title }}</h3>
          <p>{{ screen.caption }}</p>
        </figcaption>
      </figure>
    {% endfor %}
  </div>
</div>
