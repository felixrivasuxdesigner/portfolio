{# No todos los sistemas definen dark/medium/light/white: sin ellos el tablero usa grises neutros legibles #}
{% set gs = designSystem.tokens.colors.grayscale or {} %}
{% set ui = translations[locale].case_study_ui.board %}
<div class="design-board-wrapper" style="
  --theme-primary: {{ designSystem.tokens.colors.primary.hex }};
  --theme-secondary: {{ designSystem.tokens.colors.secondary.hex }};
  --theme-gray-dark: {{ (gs.dark or {}).hex or '#212529' }};
  --theme-gray-medium: {{ (gs.medium or {}).hex or '#6c757d' }};
  --theme-gray-light: {{ (gs.light or {}).hex or '#f8f9fa' }};
  --theme-gray-white: {{ (gs.white or {}).hex or '#ffffff' }};
  --theme-on-primary: {{ (gs.white or {}).hex or '#ffffff' }};
  --theme-font-primary: '{{ designSystem.tokens.typography.primary.family }}', sans-serif;
  --theme-radius: {{ designSystem.tokens.shape.borderRadius }};
  --theme-button-radius: {{ designSystem.tokens.shape.buttonRadius }};
  --theme-input-radius: {{ designSystem.tokens.shape.inputRadius }};
">

  <div class="board-header" style="text-align: center; margin-bottom: 3rem;">
    <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">{{ designSystem.title }}</h2>
    <p style="font-size: 1.1rem; color: var(--theme-gray-medium); max-width: 600px; margin: 0 auto; line-height: 1.6;">
      {{ designSystem.intro }}
    </p>
  </div>

  <!-- 1. Color Palette -->
  <section class="board-section">
    <div class="section-header">
      <h3>{{ ui.colorsTitle }}</h3>
      <p>{{ ui.colorsIntro }}</p>
    </div>
    
    <div class="colors-grid">
      <!-- Primary -->
      <div class="color-swatch-card" aria-label="{{ ui.primaryColor }}">
        <div class="swatch-color" style="background-color: var(--theme-primary);"></div>
        <div class="swatch-info">
          <div class="color-name">{{ designSystem.tokens.colors.primary.name }}</div>
          <div class="color-codes">
            <span>HEX {{ designSystem.tokens.colors.primary.hex }}</span>
            <span>RGB {{ designSystem.tokens.colors.primary.rgb }}</span>
          </div>
          <div class="color-usage">{{ designSystem.tokens.colors.primary.usage }}</div>
        </div>
      </div>

      <!-- Secondary -->
      <div class="color-swatch-card" aria-label="{{ ui.secondaryColor }}">
        <div class="swatch-color" style="background-color: var(--theme-secondary);"></div>
        <div class="swatch-info">
          <div class="color-name">{{ designSystem.tokens.colors.secondary.name }}</div>
          <div class="color-codes">
            <span>HEX {{ designSystem.tokens.colors.secondary.hex }}</span>
            <span>RGB {{ designSystem.tokens.colors.secondary.rgb }}</span>
          </div>
          <div class="color-usage">{{ designSystem.tokens.colors.secondary.usage }}</div>
        </div>
      </div>
      
      <!-- Grayscale (Loop over grayscale obj) -->
      {% for key, val in designSystem.tokens.colors.grayscale %}
      <div class="color-swatch-card" aria-label="{{ val.name }}">
        <!-- In CSS variables this is trickier to dynamically loop natively, but we can target the hex inline specifically for these swatches to show accuracy -->
        <div class="swatch-color" style="background-color: {{ val.hex }}; {% if key == 'white' or key == 'light' %}border-bottom: 1px solid rgba(0,0,0,0.05);{% endif %}"></div>
        <div class="swatch-info">
          <div class="color-name">{{ val.name }}</div>
          <div class="color-codes">
            <span>HEX {{ val.hex }}</span>
            <span>RGB {{ val.rgb }}</span>
          </div>
          <div class="color-usage">{{ val.usage }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 2. Typography -->
  <section class="board-section">
    <div class="section-header">
      <h3>{{ ui.typeTitle }}</h3>
      <p>{{ ui.typeLabel }}: <strong>{{ designSystem.tokens.typography.primary.family }}</strong> ({{ designSystem.tokens.typography.primary.category }})</p>
    </div>

    {# Si el sistema declara fontsUrl (Google Fonts), se cargan las fuentes reales para que las muestras no caigan en una sans genérica #}
    {% if designSystem.tokens.typography.fontsUrl %}
    <link rel="stylesheet" href="{{ designSystem.tokens.typography.fontsUrl }}">
    {% endif %}
    <div class="typography-grid">
      {% for font in designSystem.tokens.typography.hierarchy %}
      <div class="type-specimen">
        <div class="type-label">
          <strong>{{ font.name }}</strong>
          <span>{{ font.size }} / {{ font.weight }}</span>
          <span style="font-style: italic; font-size: 0.8em; margin-top: 0.25rem;">{{ font.usage }}</span>
        </div>
        <div class="type-sample" style="font-size: {{ font.size }}; font-weight: {{ font.weight }};{% if font.family %} font-family: '{{ font.family }}', sans-serif;{% endif %}{% if font.uppercase %} text-transform: uppercase;{% endif %}">
          {{ ui.sample }}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 3. UI Components -->
  <section class="board-section">
    <div class="section-header">
      <h3>{{ ui.componentsTitle }}</h3>
      <p>{{ ui.componentsIntro }}</p>
    </div>

    <div class="ui-grid">
      
      <!-- Buttons -->
      <div class="ui-group">
        <h4>{{ ui.buttons }}</h4>
        <div class="button-states">
          
          <div class="state-row">
            <span class="state-label">{{ ui.stateDefault }}</span>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <button class="btn-primary">{{ ui.primary }}</button>
              <button class="btn-secondary">{{ ui.secondary }}</button>
              <button class="btn-ghost">{{ ui.ghost }}</button>
            </div>
          </div>
          
          <div class="state-row">
            <span class="state-label">{{ ui.stateHover }}</span>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <button class="btn-primary hover">{{ ui.primary }}</button>
              <button class="btn-secondary hover">{{ ui.secondary }}</button>
              <button class="btn-ghost hover">{{ ui.ghost }}</button>
            </div>
          </div>
          
          <div class="state-row">
            <span class="state-label">{{ ui.stateActive }}</span>
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <button class="btn-primary active">{{ ui.primary }}</button>
              <button class="btn-secondary active">{{ ui.secondary }}</button>
              <button class="btn-ghost active">{{ ui.ghost }}</button>
            </div>
          </div>

        </div>
      </div>

      <!-- Forms -->
      <div class="ui-group">
        <h4>{{ ui.inputs }}</h4>
        <div class="form-states">
          
          <div class="input-group">
            <label>{{ ui.inputDefault }}</label>
            <input type="text" placeholder="{{ ui.inputPlaceholder }}">
          </div>
          
          <div class="input-group">
            <label>{{ ui.inputFocus }}</label>
            <input type="text" class="focus" placeholder="{{ ui.inputTyping }}" value="user@example.com">
          </div>
          
          <div class="input-group">
            <label>{{ ui.inputError }}</label>
            <input type="text" class="error" placeholder="" value="invalid-email">
            <span style="color: #ef4444; font-size: 0.8rem; margin-top: 0.25rem;">{{ ui.inputErrorMsg }}</span>
          </div>

        </div>
      </div>

    </div>
  </section>

</div>
